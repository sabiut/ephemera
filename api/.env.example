# ---- Required -------------------------------------------------------------

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ephemera

# Redis (also used as the Celery broker/result backend unless overridden)
REDIS_URL=redis://localhost:6379/0

# GitHub App (see docs/github-app-setup.md)
GITHUB_APP_ID=your_app_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret
# Provide the private key EITHER as a file path (local dev) ...
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-key.pem
# ... OR as the PEM content itself (how Kubernetes Secrets deliver it)
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Application
SECRET_KEY=your-secret-key-change-this
ENVIRONMENT=development
# Preview services are exposed at https://pr-<n>-<repo>-<service>.<BASE_DOMAIN>
BASE_DOMAIN=preview.yourdomain.com

# ---- Dashboard login (GitHub OAuth App, https://github.com/settings/developers)

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
SESSION_TOKEN_TTL_DAYS=30

# ---- Stored cloud credentials ------------------------------------------------
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Optional ---------------------------------------------------------------

# Comma-separated browser origins allowed to call the API (dashboard is same-origin)
CORS_ORIGINS=

# Comma-separated GitHub logins that see every environment. Everyone else
# sees only the environments for pull requests they authored.
ADMIN_GITHUB_LOGINS=

# How long a preview may take to become ready, and the extra time allowed while
# a pod waits for an image tagged with the PR's commit (CI still building it)
PREVIEW_READY_TIMEOUT_SECONDS=300
PREVIEW_IMAGE_WAIT_SECONDS=600

# Per-preview-namespace ResourceQuota
PREVIEW_CPU_QUOTA=1
PREVIEW_MEMORY_QUOTA=2Gi
PREVIEW_POD_QUOTA=10

# AI manifest generation: anthropic | openai | gemini
AI_DEPLOYMENT_ENABLED=true
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Verify the Redis TLS certificate for rediss:// URLs (needs the CA in the trust store)
REDIS_SSL_VERIFY=false

# Only used by the AWS/EKS deployment path
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=
CLUSTER_NAME=ephemera-dev
